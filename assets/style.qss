* {
    font-family: "Vazirmatn", "Segoe UI", "Tahoma";
    color: #0F172A;
}

QMainWindow,
QWidget {
    background: #F8FAFC;
}

QFrame#sidebar {
    background: #FFFFFF;
    border-left: 1px solid #E2E8F0;
}

QLabel#logo {
    color: #1E3A8A;
    font-size: 28px;
    font-weight: 800;
}

QLabel#sidebarSubtitle,
QLabel#sidebarNetwork,
QLabel#pageSubtitle,
QLabel#statTitle {
    color: #64748B;
    font-size: 12px;
}

QLabel#sidebarNetwork {
    font-size: 11px;
    line-height: 140%;
    padding: 0 4px;
}

QLabel#sidebarCity {
    color: #1E3A8A;
    font-size: 24px;
    font-weight: 800;
    padding-top: 2px;
}

QLabel#pageTitle {
    color: #0F172A;
    font-size: 24px;
    font-weight: 800;
}

QLabel#sectionTitle {
    color: #0F172A;
    font-size: 16px;
    font-weight: 700;
}

QLabel#activeDriversCount {
    background: #ECFDF5;
    color: #15803D;
    border: 1px solid #BBF7D0;
    border-radius: 12px;
    padding: 8px 14px;
    font-weight: 800;
}

QFrame#driversSummaryCard {
    background: #FFFFFF;
    border: 1px solid #BFDBFE;
    border-radius: 16px;
    min-width: 520px;
}

QLabel#driversSummaryTitle {
    color: #64748B;
    font-size: 13px;
    font-weight: 700;
}

QLabel#driversSummaryValue,
QLabel#driversSummaryValueActive,
QLabel#driversSummaryValueInactive {
    font-size: 28px;
    font-weight: 800;
}

QLabel#driversSummaryValue {
    color: #1E3A8A;
}

QLabel#driversSummaryValueActive {
    color: #15803D;
}

QLabel#driversSummaryValueInactive {
    color: #B45309;
}

QFrame#driverFormCard {
    background: #FFFFFF;
    border: 1px solid #BFDBFE;
    border-radius: 18px;
}

QFrame#driverFormTitleBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E3A8A, stop:1 #2563EB);
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
}

QLabel#driverFormTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}

QScrollArea#driverFormScroll,
QScrollArea#driverFormScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QGroupBox#driverFormGroup {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    margin-top: 14px;
    padding: 14px 12px 12px 12px;
    font-weight: 700;
}

QGroupBox#driverFormGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    padding: 0 10px;
    color: #1E3A8A;
}

QFrame#driverFieldBox {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

QFrame#driverFormCard QLabel#fieldLabel {
    color: #0F172A;
    font-size: 11px;
    font-weight: 800;
    qproperty-alignment: AlignRight;
}

QFrame#driverFormCard QLineEdit {
    qproperty-alignment: AlignRight;
    padding-right: 12px;
    padding-left: 12px;
}

QFrame#driverFormCard QComboBox {
    padding-right: 12px;
    padding-left: 36px;
}

QFrame#card,
QFrame#statCard {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 18px;
}

QFrame#dateCard {
    background: #EFF6FF;
    border: 1px solid #DBEAFE;
    border-radius: 14px;
    padding: 12px;
}

QLabel#statValue {
    color: #0F172A;
    font-size: 28px;
    font-weight: 800;
}

QPushButton {
    min-height: 34px;
    border-radius: 9px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton#navButton {
    background: transparent;
    color: #334155;
    border: none;
    text-align: center;
    padding: 12px 10px;
    min-width: 190px;
    qproperty-iconSize: 24px 24px;
}

QLabel#weekdayLabel {
    color: #1E3A8A;
    font-size: 14px;
    font-weight: 700;
}

QLabel#sidebarFooter {
    color: #64748B;
    font-size: 10px;
    line-height: 160%;
    padding-top: 8px;
}

QPushButton#navButton:hover {
    background: #EFF6FF;
    color: #2563EB;
}

QPushButton#navButton[active="true"] {
    background: #DBEAFE;
    color: #2563EB;
    font-weight: 800;
}

QPushButton#optionButton {
    background: #FFFFFF;
    color: #1E3A8A;
    border: 1px solid #BFDBFE;
    border-radius: 18px;
    padding: 20px;
    font-size: 15px;
    text-align: center;
}

QPushButton#optionButton[variant="success"] {
    background: #DCFCE7;
    color: #166534;
    border: 1px solid #86EFAC;
}

QPushButton#optionButton[variant="success"]:hover {
    background: #BBF7D0;
    border: 1px solid #22C55E;
}

QPushButton#optionButton:hover {
    background: #EFF6FF;
    border: 1px solid #2563EB;
}

QPushButton#optionButton[variant="success"]:hover {
    background: #BBF7D0;
    border: 1px solid #22C55E;
}

QFrame#profileOverlay {
    background: rgba(15, 23, 42, 95);
}

QFrame#profileCard {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 18px;
}

QLabel#profileInfo {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 8px 10px;
    line-height: 150%;
}

QFrame#fieldBox {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

QWidget#destinationActions {
    background: transparent;
}

QPushButton#destinationActionButton {
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
    font-size: 15px;
    font-weight: 800;
}

QLabel#fieldLabel {
    color: #0F172A;
    font-size: 11px;
    font-weight: 800;
}

QPushButton[role="primary"] {
    background: #22C55E;
    color: #FFFFFF;
    border: 1px solid #16A34A;
}

QPushButton[role="primary"]:hover {
    background: #16A34A;
}

QPushButton[role="secondary"] {
    background: #EFF6FF;
    color: #2563EB;
    border: 1px solid #BFDBFE;
}

QPushButton[role="danger"] {
    background: #FEF2F2;
    color: #EF4444;
    border: 1px solid #FECACA;
}

QPushButton[role="ghost"] {
    background: #FFFFFF;
    color: #475569;
    border: 1px solid #CBD5E1;
}

QLineEdit,
QComboBox,
QDoubleSpinBox,
QPlainTextEdit {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    min-height: 36px;
    padding: 6px 12px;
    selection-background-color: #2563EB;
}

QComboBox {
    padding-left: 36px;
    padding-right: 12px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: left center;
    width: 30px;
    border: none;
    border-right: 1px solid #E2E8F0;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    background: #F8FAFC;
}

QComboBox::drop-down:hover {
    background: #EFF6FF;
}

QComboBox::down-arrow {
    image: url(@ASSETS@/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
}

QComboBox:on {
    border: 1px solid #2563EB;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    color: #0F172A;
    border: 1px solid #BFDBFE;
    border-radius: 10px;
    padding: 6px;
    outline: 0;
    selection-background-color: #DBEAFE;
    selection-color: #1D4ED8;
}

QDoubleSpinBox {
    padding-left: 12px;
    padding-right: 36px;
}

QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 24px;
    border: none;
    background: #F8FAFC;
}

QDoubleSpinBox::up-button {
    subcontrol-position: top left;
    border-bottom: 1px solid #E2E8F0;
    border-top-left-radius: 10px;
}

QDoubleSpinBox::down-button {
    subcontrol-position: bottom left;
    border-bottom-left-radius: 10px;
}

QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background: #EFF6FF;
}

QDoubleSpinBox::up-arrow {
    image: url(@ASSETS@/icons/chevron-up.svg);
    width: 10px;
    height: 10px;
}

QDoubleSpinBox::down-arrow {
    image: url(@ASSETS@/icons/chevron-down.svg);
    width: 10px;
    height: 10px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 6px 2px 6px 0;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 5px;
    min-height: 48px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0 6px 2px 6px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 5px;
    min-width: 48px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

QLineEdit {
    qproperty-alignment: AlignRight;
}

QGroupBox {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    margin-top: 12px;
    padding: 12px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    padding: 0 8px;
    color: #1E3A8A;
}

QLineEdit:focus,
QComboBox:focus,
QDoubleSpinBox:focus,
QPlainTextEdit:focus {
    border: 1px solid #2563EB;
}

QTableWidget,
QTreeWidget {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    gridline-color: #E2E8F0;
    alternate-background-color: #F8FAFC;
}

QHeaderView::section {
    background: #F1F5F9;
    color: #334155;
    border: none;
    border-left: 1px solid #E2E8F0;
    padding: 9px;
    font-weight: 700;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:selected,
QTreeWidget::item:selected {
    background: #DBEAFE;
    color: #1D4ED8;
}

QStatusBar#statusBar {
    background: #FFFFFF;
    border-top: 1px solid #E2E8F0;
}

QLabel#statusCredits {
    color: #475569;
    font-size: 11px;
}

QWidget#dashboardPage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #F8FAFC, stop:0.5 #EFF6FF, stop:1 #F8FAFC);
}

QPushButton#dashboardActionButton {
    min-height: 42px;
    font-size: 14px;
    padding: 8px 22px;
}

QPushButton#dashboardReserveButton {
    min-height: 42px;
    font-size: 14px;
    padding: 8px 22px;
    background: #FFF7ED;
    color: #C2410C;
    border: 1px solid #FDBA74;
}

QPushButton#dashboardReserveButton:hover {
    background: #FFEDD5;
    border: 1px solid #F97316;
}

QWidget#dashboardPage QLabel#pageTitle,
QWidget#dashboardPage QLabel#pageSubtitle {
    qproperty-alignment: AlignCenter;
}

QFrame#dashboardTableCard {
    background: #FFFFFF;
    border: 1px solid #BFDBFE;
    border-radius: 18px;
}

QTabWidget#dashboardTablesTabs::pane {
    border: none;
    background: #FFFFFF;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
    top: -1px;
}

QTabWidget#dashboardTablesTabs QTabBar {
    background: transparent;
}

QTabWidget#dashboardTablesTabs QTabBar::tab {
    background: #EFF6FF;
    color: #475569;
    border: 1px solid #BFDBFE;
    border-bottom: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    padding: 11px 26px;
    margin-left: 6px;
    font-weight: 700;
    min-width: 120px;
}

QTabWidget#dashboardTablesTabs QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E3A8A, stop:1 #2563EB);
    color: #FFFFFF;
    border-color: #2563EB;
}

QTabWidget#dashboardTablesTabs QTabBar::tab:hover:!selected {
    background: #DBEAFE;
    color: #1D4ED8;
}

QFrame#dashboardMissionsHeader,
QFrame#dashboardReservationsHeader,
QFrame#dashboardTableHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E3A8A, stop:1 #2563EB);
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
}

QFrame[dashboardHeader="true"] QLabel#dashboardTableTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}

QTableWidget#dashboardTable,
QTableWidget#dashboardReservationsTable {
    border: none;
    background: #FFFFFF;
}

QFrame#missionOverlay {
    background: rgba(15, 23, 42, 0.45);
}

QFrame#missionModalCard {
    background: #FFFFFF;
    border: 1px solid #BFDBFE;
    border-radius: 20px;
}

QScrollArea#missionModalScroll {
    background: transparent;
    border: none;
}

QWidget#missionFormWidget {
    background: transparent;
}

QFrame#missionModalCard QGroupBox {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    margin-top: 14px;
    padding: 14px;
}

QFrame#missionModalCard QLabel#sectionTitle {
    color: #1E3A8A;
    font-size: 18px;
    font-weight: 800;
    padding-bottom: 4px;
}
